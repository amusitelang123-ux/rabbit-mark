NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xtx_mall
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads

PAY_ADAPTER=sandbox
PAY_SECRET=change_me_in_production
SMS_ADAPTER=console
LOGISTICS_ADAPTER=mock

# 登录图形验证码（U-41 防爆破）：false 可在本地联调时关闭
CAPTCHA_ENABLED=true

CORS_ORIGIN=http://localhost:5173

# ============ AI 智能客服（DeepSeek） ============
# API Key 只写在这里，不要提交到 Git。
# 留空时自动降级为演示模式（mock 适配器）：功能可跑通，但回答是内置话术。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

AI_ENABLED=true
AI_ADAPTER=deepseek
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.3
# 每日成本上限（元）：超过后自动停止调用并引导转人工
AI_DAILY_BUDGET_CNY=20
# 成本估算单价（元/百万 token），仅用于后台统计
AI_PRICE_IN_PER_M=2
AI_PRICE_OUT_PER_M=8
# 送入模型的历史消息条数
AI_MAX_HISTORY=8
