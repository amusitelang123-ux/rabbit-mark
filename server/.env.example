NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xtx_mall
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads

PAY_ADAPTER=sandbox
PAY_SECRET=change_me_in_production
SMS_ADAPTER=console
LOGISTICS_ADAPTER=mock

# 登录图形验证码（U-41 防爆破）：false 可在本地联调时关闭
CAPTCHA_ENABLED=true

CORS_ORIGIN=http://localhost:5173
